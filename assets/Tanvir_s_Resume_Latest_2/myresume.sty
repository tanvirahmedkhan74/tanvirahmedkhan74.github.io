%=========================================================
% myresume.sty
% Academic CV Style
% Tanvir Ahmed Khan
%
% Compiler: XeLaTeX
%=========================================================

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{myresume}[2026/09/09 Academic CV Style]


%=========================================================
% PAGE GEOMETRY
%=========================================================

\RequirePackage[
    a4paper,
    top=1.55cm,
    bottom=1.65cm,
    left=1.75cm,
    right=1.75cm
]{geometry}


%=========================================================
% TYPOGRAPHY
%=========================================================

\RequirePackage{fontspec}

% Professional and portable fonts available in TeX Live.
%
% TeX Gyre Termes:
%   Times-style serif for academic body text.
%
% TeX Gyre Heros:
%   Helvetica-style sans serif for restrained headings.

% Use file names instead of system font-family lookup so the same bundled
% TeX Gyre faces resolve consistently in Tectonic and full TeX Live builds.
\setmainfont{texgyretermes}[
    Extension=.otf,
    UprightFont=*-regular,
    BoldFont=*-bold,
    ItalicFont=*-italic,
    BoldItalicFont=*-bolditalic
]
\setsansfont{texgyreheros}[
    Extension=.otf,
    UprightFont=*-regular,
    BoldFont=*-bold,
    ItalicFont=*-italic,
    BoldItalicFont=*-bolditalic
]

\RequirePackage{microtype}
\RequirePackage{setspace}

\setstretch{1.06}

\setlength{\parindent}{0pt}
\setlength{\parskip}{1pt}
\setlength{\emergencystretch}{3em}


%=========================================================
% CORE PACKAGES
%=========================================================

\RequirePackage{xcolor}
\RequirePackage{titlesec}
\RequirePackage{enumitem}
\RequirePackage{tabularx}
\RequirePackage{array}
\RequirePackage{ragged2e}
\RequirePackage{needspace}
\RequirePackage{hyperref}
\RequirePackage{fancyhdr}


%=========================================================
% COLORS
%=========================================================

% Restrained hyperlink color appropriate for an academic CV.

\definecolor{CVLink}{HTML}{1F4E79}


%=========================================================
% HYPERLINK SETTINGS
%=========================================================

\hypersetup{
    colorlinks=true,
    linkcolor=CVLink,
    urlcolor=CVLink,
    citecolor=CVLink,
    pdfborder={0 0 0}
}

\urlstyle{same}


%=========================================================
% GENERAL DOCUMENT SETTINGS
%=========================================================

\raggedbottom

% Academic CV sections are not numbered.

\setcounter{secnumdepth}{0}


%=========================================================
% PAGE FOOTER
%=========================================================

\pagestyle{fancy}

\fancyhf{}

\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}

\fancyfoot[L]{%
    \sffamily
    \fontsize{8.5pt}{10pt}\selectfont
    Tanvir Ahmed Khan
}

\fancyfoot[R]{%
    \sffamily
    \fontsize{8.5pt}{10pt}\selectfont
    \thepage
}

\setlength{\footskip}{20pt}


%=========================================================
% SECTION TITLES
%=========================================================

\titleformat{\section}
    {\sffamily
     \bfseries
     \fontsize{12.5pt}{14pt}\selectfont}
    {}
    {0pt}
    {}
    [\vspace{1pt}\titlerule]

\titlespacing*{\section}
    {0pt}
    {7.5pt}
    {5pt}


%=========================================================
% SUBSECTION LABEL
%
% Example:
%
% \cvSubsection{Peer-Reviewed Publications and Accepted Papers}
%=========================================================

\newcommand{\cvSubsection}[1]{%
    \vspace{2pt}%
    {%
        \sffamily
        \bfseries
        \fontsize{10.5pt}{12pt}\selectfont
        #1%
    }%
    \par
    \vspace{2pt}%
}


%=========================================================
% PUBLICATION LIST
%=========================================================

\newcommand{\pubListStart}{%
    \begin{enumerate}[
        label={[\arabic*]},
        leftmargin=2.25em,
        labelsep=0.55em,
        itemsep=5.5pt,
        topsep=3pt,
        parsep=0pt,
        partopsep=0pt
    ]
}

\newcommand{\pubListEnd}{%
    \end{enumerate}
}


%=========================================================
% NORMAL BULLET LISTS
%=========================================================

\newcommand{\itemListStart}{%
    \begin{itemize}[
        leftmargin=1.35em,
        label=\textbullet,
        itemsep=2pt,
        topsep=3pt,
        parsep=0pt,
        partopsep=0pt
    ]
}

\newcommand{\itemListEnd}{%
    \end{itemize}
}

\newcommand{\myItem}[1]{%
    \item #1
}


%=========================================================
% SKILLS LIST
%
% No bullets: category names provide the hierarchy.
%=========================================================

\newcommand{\skillListStart}{%
    \begin{itemize}[
        leftmargin=0pt,
        label={},
        itemsep=3pt,
        topsep=3pt,
        parsep=0pt,
        partopsep=0pt,
        before=\raggedright
    ]
}

\newcommand{\skillListEnd}{%
    \end{itemize}
}


%=========================================================
% EDUCATION HEADING
%
% Usage:
%
% \eduHeading
%     {Institution}
%     {Location}
%     {Degree}
%     {Dates}
%=========================================================

\newcommand{\eduHeading}[4]{%
    \begingroup
    \renewcommand{\arraystretch}{1.08}%
    \begin{tabularx}
        {\textwidth}
        {@{}X>{\raggedleft\arraybackslash}p{3.5cm}@{}}

        \textbf{#1}
        &
        #2
        \\[-1pt]

        \textit{#3}
        &
        #4

    \end{tabularx}
    \endgroup
    \vspace{-2pt}%
}


%=========================================================
% RESEARCH / INDUSTRY EXPERIENCE HEADING
%
% Usage:
%
% \internHeading
%     {Organization}
%     {Institution / Location}
%     {Dates}
%=========================================================

\newcommand{\internHeading}[3]{%
    \begingroup
    \renewcommand{\arraystretch}{1.08}%
    \begin{tabularx}
        {\textwidth}
        {@{}X>{\raggedleft\arraybackslash}p{3.5cm}@{}}

        \textbf{#1}
        \enspace\textbar\enspace
        #2
        &
        #3

    \end{tabularx}
    \endgroup
    \vspace{-2pt}%
}


%=========================================================
% PROJECT HEADING
%
% Usage:
%
% \projHeading
%     {Project Title}
%     {Description}
%     {Dates}
%     {Optional Link}
%=========================================================

\newcommand{\projHeading}[4]{%
    \begingroup
    \renewcommand{\arraystretch}{1.08}%
    \begin{tabularx}
        {\textwidth}
        {@{}>{\RaggedRight\arraybackslash}X>{\raggedleft\arraybackslash}p{3.3cm}@{}}

        \textbf{#1}
        &
        #3
        \\[-1pt]

        {\small #2}
        &
        {\small #4}

    \end{tabularx}
    \endgroup
    \vspace{3.5pt}%
}


%=========================================================
% GENERIC TWO-COLUMN ENTRY
%
% Useful for awards, honors, certifications, etc.
%
% Usage:
%
% \cvEntry
%     {Description}
%     {Date}
%=========================================================

\newcommand{\cvEntry}[2]{%
    \begin{tabularx}
        {\textwidth}
        {@{}X>{\raggedleft\arraybackslash}p{2.4cm}@{}}

        #1
        &
        #2

    \end{tabularx}
}


%=========================================================
% OPTIONAL LINK HELPERS
%=========================================================

\newcommand{\githubLink}[1]{%
    \href{#1}{GitHub}%
}

\newcommand{\doiLink}[1]{%
    \href{https://doi.org/#1}{DOI}%
}

\newcommand{\arxivLink}[1]{%
    \href{https://arxiv.org/abs/#1}{arXiv}%
}


%=========================================================
% END OF PACKAGE
%=========================================================
