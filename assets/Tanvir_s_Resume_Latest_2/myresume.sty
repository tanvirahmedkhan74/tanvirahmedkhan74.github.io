%=========================================================
% myresume.sty
% Academic CV Style
% Tanvir Ahmed Khan
%
% Compiler: XeLaTeX
%=========================================================

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{myresume}[2026/09/28 Academic CV Style]


%=========================================================
% PAGE GEOMETRY
%=========================================================

\RequirePackage[
    a4paper,
    top=1.55cm,
    bottom=1.65cm,
    left=1.75cm,
    right=1.75cm
]{geometry}


%=========================================================
% TYPOGRAPHY
%=========================================================

\RequirePackage{fontspec}

% Professional and portable fonts available in TeX Live.
%
% TeX Gyre Termes:
%   Times-style serif for academic body text.
%
% TeX Gyre Heros:
%   Helvetica-style sans serif for restrained headings.

% Resolve the TeX-distributed files directly, including on Linux systems
% without these font families registered in the system font catalogue.
\setmainfont{texgyretermes-regular.otf}[
    BoldFont=texgyretermes-bold.otf,
    ItalicFont=texgyretermes-italic.otf,
    BoldItalicFont=texgyretermes-bolditalic.otf
]
\setsansfont{texgyreheros-regular.otf}[
    BoldFont=texgyreheros-bold.otf,
    ItalicFont=texgyreheros-italic.otf,
    BoldItalicFont=texgyreheros-bolditalic.otf
]

\RequirePackage{microtype}
\RequirePackage{setspace}

\setstretch{1.06}

\setlength{\parindent}{0pt}
\setlength{\parskip}{1pt}
\setlength{\emergencystretch}{1.5em}


%=========================================================
% CORE PACKAGES
%=========================================================

\RequirePackage{xcolor}
\RequirePackage{titlesec}
\RequirePackage{enumitem}
\RequirePackage{tabularx}
\RequirePackage{array}
\RequirePackage{ragged2e}

% A slightly wider ragged edge, so entry text can break between words
% instead of hyphenating.
\setlength{\RaggedRightRightskip}{0pt plus 3em}
\RequirePackage{needspace}
\RequirePackage{hyperref}
\RequirePackage{fancyhdr}


%=========================================================
% COLORS
%=========================================================

% Restrained hyperlink color appropriate for an academic CV.

\definecolor{CVLink}{HTML}{1F4E79}


%=========================================================
% HYPERLINK SETTINGS
%=========================================================

\hypersetup{
    colorlinks=true,
    linkcolor=CVLink,
    urlcolor=CVLink,
    citecolor=CVLink,
    pdfborder={0 0 0}
}

\urlstyle{same}


%=========================================================
% GENERAL DOCUMENT SETTINGS
%=========================================================

\raggedbottom

% Academic CV sections are not numbered.

\setcounter{secnumdepth}{0}


%=========================================================
% PAGE FOOTER
%=========================================================

\pagestyle{fancy}

\fancyhf{}

\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}

\fancyfoot[L]{%
    \sffamily
    \fontsize{8.5pt}{10pt}\selectfont
    Tanvir Ahmed Khan
}

\fancyfoot[R]{%
    \sffamily
    \fontsize{8.5pt}{10pt}\selectfont
    \thepage
}

\setlength{\footskip}{20pt}


%=========================================================
% SECTION TITLES
%=========================================================

\titleformat{\section}
    {\sffamily
     \bfseries
     \fontsize{12.5pt}{14pt}\selectfont}
    {}
    {0pt}
    {}
    [\vspace{1pt}\titlerule]

\titlespacing*{\section}
    {0pt}
    {8pt}
    {5pt}


%=========================================================
% SUBSECTION LABEL
%
% Example:
%
% \cvSubsection{Peer-Reviewed Publications and Accepted Papers}
%=========================================================

\newcommand{\cvSubsection}[1]{%
    \par\Needspace{8\baselineskip}%
    \vspace{2pt}%
    {%
        \sffamily
        \bfseries
        \fontsize{10.5pt}{12pt}\selectfont
        #1%
    }%
    \par
    \vspace{2pt}%
}


%=========================================================
% PUBLICATION LIST
%=========================================================

\newcommand{\pubListStart}{%
    \begin{enumerate}[
        label={[\arabic*]},
        leftmargin=2.25em,
        labelsep=0.55em,
        itemsep=7pt,
        topsep=3pt,
        parsep=0pt,
        partopsep=0pt
    ]
}

\newcommand{\pubListEnd}{%
    \end{enumerate}
}


%=========================================================
% NORMAL BULLET LISTS
%=========================================================

\newcommand{\itemListStart}{%
    \begin{itemize}[
        leftmargin=1.35em,
        label=\textbullet,
        itemsep=2.5pt,
        topsep=3pt,
        parsep=0pt,
        partopsep=0pt
    ]
}

\newcommand{\itemListEnd}{%
    \end{itemize}
}

\newcommand{\myItem}[1]{%
    \item #1
}


%=========================================================
% SKILLS LIST
%
% No bullets: category names provide the hierarchy.
%=========================================================

\newcommand{\skillListStart}{%
    \begin{itemize}[
        leftmargin=0pt,
        label={},
        itemsep=3pt,
        topsep=3pt,
        parsep=0pt,
        partopsep=0pt
    ]
}

\newcommand{\skillListEnd}{%
    \end{itemize}
}


%=========================================================
% EDUCATION HEADING
%
% Usage:
%
% \eduHeading
%     {Institution}
%     {Location}
%     {Degree}
%     {Dates}
%=========================================================

\newcommand{\eduHeading}[4]{%
    \begingroup
    \renewcommand{\arraystretch}{1.08}%
    \begin{tabularx}
        {\textwidth}
        {@{}X>{\raggedleft\arraybackslash}p{3.5cm}@{}}

        \textbf{#1}
        &
        #2
        \\[-1pt]

        \textit{#3}
        &
        #4

    \end{tabularx}
    \endgroup
    \vspace{-2pt}%
}


%=========================================================
% RESEARCH / INDUSTRY EXPERIENCE HEADING
%
% Usage:
%
% \internHeading
%     {Organization}
%     {Institution / Location}
%     {Dates}
%=========================================================

\newcommand{\internHeading}[3]{%
    \begingroup
    \renewcommand{\arraystretch}{1.08}%
    \begin{tabularx}
        {\textwidth}
        {@{}X>{\raggedleft\arraybackslash}p{3.5cm}@{}}

        \textbf{#1}
        \enspace\textbar\enspace
        #2
        &
        #3

    \end{tabularx}
    \endgroup
    \vspace{-2pt}%
}


%=========================================================
% ENTRY HEADING
%
% A title on the left and a right-aligned role/status or date
% in a fixed column, so every entry shares one vertical rule.
%
% \entryHeading{Title}{Right-aligned status or date}
%=========================================================

\newlength{\cvStatusWidth}
\setlength{\cvStatusWidth}{5.45cm}

\newcommand{\entryHeading}[2]{%
    \par
    \begingroup
    \renewcommand{\arraystretch}{1.0}%
    \setlength{\tabcolsep}{0pt}%
    \begin{tabularx}
        {\textwidth}
        {@{}>{\RaggedRight\arraybackslash}X@{\hspace{0.8em}}>{\raggedleft\arraybackslash}p{\cvStatusWidth}@{}}

        \textbf{#1}
        &
        {\small #2}

    \end{tabularx}%
    \endgroup
    \par\nobreak
}


%=========================================================
% RESEARCH / PROJECT ENTRY
%
% \researchEntry
%     {Short title}
%     {Role and status}
%     {Working title, venue and other metadata}
%     {Project page URL}
%
% Followed by a `points' environment with the contribution
% bullets. \Needspace keeps a heading with its first bullets.
%=========================================================

\newcommand{\researchEntry}[4]{%
    \par\addvspace{1pt}%
    \Needspace{6\baselineskip}%
    \entryHeading{\href{#4}{#1}}{#2}%
    \nobreak\vspace{1.5pt}%
    {\small\RaggedRight\hyphenpenalty=10000\exhyphenpenalty=10000\relax #3\par}%
    \nobreak
}


%=========================================================
% CONTRIBUTION POINTS
%
% Short ragged-right bullets indented under an entry heading.
%=========================================================

\newenvironment{points}
    {%
        \vspace{1.5pt}%
        \RaggedRight
        \hyphenpenalty=10000\exhyphenpenalty=10000\relax
        \begin{itemize}[
            leftmargin=1.25em,
            labelsep=0.5em,
            label=\textendash,
            itemsep=2pt,
            topsep=0pt,
            parsep=0pt,
            partopsep=0pt
        ]%
    }
    {%
        \end{itemize}%
        \vspace{6pt}%
    }


%=========================================================
% GROUP HEADING
%
% A sans-serif label for a group of related milestones, with
% the same right-aligned status column as the entry headings.
%
% \milabGroup{Group title}{Role}
%=========================================================

\newcommand{\milabGroup}[2]{%
    \par\addvspace{4pt}%
    \Needspace{5\baselineskip}%
    \begingroup
    \renewcommand{\arraystretch}{1.0}%
    \setlength{\tabcolsep}{0pt}%
    \begin{tabularx}
        {\textwidth}
        {@{}>{\RaggedRight\arraybackslash}X@{\hspace{0.8em}}>{\raggedleft\arraybackslash}p{\cvStatusWidth}@{}}

        {\sffamily\bfseries\fontsize{10.5pt}{12.5pt}\selectfont #1}
        &
        {\small #2}

    \end{tabularx}%
    \endgroup
    \par\nobreak\vspace{4pt}%
}


%=========================================================
% RUN-IN ENTRY
%
% A bold lead-in title followed by its description on the
% same line, with continuation lines indented. Used for the
% MILab workstreams and the shorter engineering projects.
%
% \runinEntry{Title}{Description}
%=========================================================

\newcommand{\runinEntry}[2]{%
    \par\Needspace{2.5\baselineskip}%
    \begingroup
    \RaggedRight
    \hyphenpenalty=10000\exhyphenpenalty=10000\relax
    \setlength{\hangindent}{1.25em}%
    \setlength{\hangafter}{1}%
    \textbf{#1}\enspace #2\par
    \endgroup
    \vspace{4.5pt}%
}


%=========================================================
% GENERIC TWO-COLUMN ENTRY
%
% Useful for awards, honors, certifications, etc.
%
% Usage:
%
% \cvEntry
%     {Description}
%     {Date}
%=========================================================

\newcommand{\cvEntry}[2]{%
    \noindent #1\hfill #2\par
}


%=========================================================
% OPTIONAL LINK HELPERS
%=========================================================

\newcommand{\githubLink}[1]{%
    \href{#1}{GitHub}%
}

\newcommand{\doiLink}[1]{%
    \href{https://doi.org/#1}{DOI}%
}

\newcommand{\arxivLink}[1]{%
    \href{https://arxiv.org/abs/#1}{arXiv}%
}


%=========================================================
% END OF PACKAGE
%=========================================================
